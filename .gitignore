import test from 'node:test';
import assert from 'node:assert/strict';

import { defaultSettings } from '../src/config.js';
import { renderNavigation } from '../src/navigation.js';
import { renderModule } from '../src/module-manager.js';
import { applySettings } from '../src/ui.js';
import { loadSettings, saveSettings } from '../src/utils.js';

const mockLocalStorage = () => {
  const values = new Map();
  return {
    getItem(key) {
      return values.has(key) ? values.get(key) : null;
    },
    setItem(key, value) {
      values.set(key, String(value));
    },
    removeItem(key) {
      values.delete(key);
    },
    clear() {
      values.clear();
    }
  };
};

test('settings can be saved and reloaded from storage', () => {
  globalThis.localStorage = mockLocalStorage();

  const settings = { ...defaultSettings, accent: '#ff00ff', compactMode: true };
  const saved = saveSettings(settings);
  assert.equal(saved, true);

  const reloaded = loadSettings();
  assert.equal(reloaded.accent, '#ff00ff');
  assert.equal(reloaded.compactMode, true);
});

test('navigation renders the module buttons', () => {
  const navElement = {
    classList: { toggle() {} },
    innerHTML: ''
  };

  globalThis.document = {
    getElementById(id) {
      return id === 'nav' ? navElement : null;
    }
  };

  renderNavigation('dashboard', false);
  assert.match(navElement.innerHTML, /data-nav="dashboard"/);
  assert.match(navElement.innerHTML, /Player Information/);
});

test('all modules render their expected headings', () => {
  const appState = {
    settings: { ...defaultSettings },
    profile: {
      winRate: 68,
      streak: 11,
      matchesToday: 12,
      trainingScore: 91,
      level: 225,
      playerName: 'Liam K',
      focusMode: 'Neutral'
    },
    training: {
      comboFocus: 'Crescent Press',
      drillStatus: 'Ready',
      combatRepCount: 14,
      lastSession: 'Today • 12:45'
    }
  };

  const moduleHtml = {
    dashboard: renderModule('dashboard', appState),
    settings: renderModule('settings', appState),
    'combo-training': renderModule('combo-training', appState),
    'cooldown-tracker': renderModule('cooldown-tracker', appState),
    'movement-reference': renderModule('movement-reference', appState)
  };

  assert.match(moduleHtml.dashboard, /Dashboard/);
  assert.match(moduleHtml.settings, /Settings/);
  assert.match(moduleHtml['combo-training'], /Combo Training/);
  assert.match(moduleHtml['cooldown-tracker'], /Cooldown Tracker/);
  assert.match(moduleHtml['movement-reference'], /Movement Reference/);
});

test('settings apply to the document without throwing', () => {
  globalThis.document = {
    documentElement: {
      style: {
        setProperty() {}
      }
    },
    body: {
      classList: {
        toggle() {}
      }
    },
    getElementById() {
      return {
        classList: { toggle() {} }
      };
    }
  };

  assert.doesNotThrow(() => applySettings(defaultSettings));
});
